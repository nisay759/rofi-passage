#!/usr/bin/env python3
"""Fake wl-copy: the clipboard is the file $FAKE_CLIP."""

import json
import os
import sys

argv = sys.argv[1:]
if argv == ["--version"]:
    print("wl-clipboard 2.3.0")
    sys.exit(0)
with open(os.environ["FAKE_LOG"], "a") as log:
    log.write(json.dumps({"tool": "wl-copy", "argv": argv}) + "\n")
data = b"" if "--clear" in argv else sys.stdin.buffer.read()
with open(os.environ["FAKE_CLIP"], "wb") as f:
    f.write(data)
