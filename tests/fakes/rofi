#!/usr/bin/env python3
"""Scripted rofi: pops the next {"pick": row, "code": n} from $FAKE_ROFI_SCRIPT."""

import json
import os
import sys

argv = sys.argv[1:]
if argv == ["-version"]:
    print("Version: 2.0.0")
    sys.exit(0)
rows = sys.stdin.read().splitlines()
with open(os.environ["FAKE_LOG"], "a") as log:
    log.write(json.dumps({"tool": "rofi", "argv": argv, "rows": rows}) + "\n")

script_path = os.environ["FAKE_ROFI_SCRIPT"]
try:
    with open(script_path) as f:
        script = json.load(f)
except FileNotFoundError:
    script = []
if not script:
    sys.exit(1)
step = script.pop(0)
with open(script_path, "w") as f:
    json.dump(script, f)

code = step.get("code", 0)
pick = step.get("pick")
if pick is None:
    sys.exit(code)
fmt = argv[argv.index("-format") + 1] if "-format" in argv else "s"
if fmt == "i":
    print(rows.index(pick))
else:
    print(pick)
sys.exit(code)
