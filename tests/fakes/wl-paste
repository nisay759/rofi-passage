#!/usr/bin/env python3
"""Fake wl-paste: prints $FAKE_CLIP; fails when it holds no text, like wl-paste."""

import os
import sys

try:
    with open(os.environ["FAKE_CLIP"], "rb") as f:
        data = f.read()
except FileNotFoundError:
    data = b""
if not data:
    sys.exit(1)
sys.stdout.buffer.write(data)
